<Window x:Class="InstallerKeeper.WingetCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar aplicación de WinGet"
        Width="920" Height="660" MinWidth="780" MinHeight="540"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PanelBrush}"
        WindowStartupLocation="CenterOwner"
        Icon="{StaticResource BrandIcon}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Resultados de búsqueda en WinGet" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Selecciona el paquete correcto y verifica su identificador antes de asociarlo." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="CandidatesGrid" ItemsSource="{Binding Candidates}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="38"
                      Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                      BorderThickness="0" SelectionChanged="CandidatesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Aplicación" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
                    <DataGridTextColumn Header="Identificador" Binding="{Binding Id}" SortMemberPath="Id" Width="2*"/>
                    <DataGridTextColumn Header="Versión" Binding="{Binding Version}" SortMemberPath="Version" Width="*"/>
                    <DataGridTextColumn Header="Origen" Binding="{Binding Source}" SortMemberPath="Source" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusText" Text="Selecciona un paquete para verificarlo." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="VerifyButton" Grid.Column="1" Content="Verificar ID exacto" Padding="16,7" IsEnabled="False" Click="Verify_Click"/>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <TextBox x:Name="VerifiedDetailsText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"
                     FontFamily="Consolas, Segoe UI" Foreground="{DynamicResource TextBrush}"
                     ToolTip="Los datos de WinGet del paquete verificado aparecerán aquí."/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="18,8" Margin="0,0,10,0"/>
            <Button x:Name="ConfirmButton" Content="Usar este paquete" Background="{DynamicResource PrimaryBrush}"
                    Foreground="White" BorderThickness="0" Padding="18,8" IsEnabled="False" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
