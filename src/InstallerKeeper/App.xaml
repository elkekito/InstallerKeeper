<Application x:Class="InstallerKeeper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:InstallerKeeper.Converters">
    <Application.Resources>
        <!-- Converters -->
        <converters:NameInitialsConverter x:Key="NameInitialsConverter"/>
        <converters:ShellIconConverter x:Key="ShellIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Dynamic Palette Brushes -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F8FC"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#087BFA"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#182230"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#F2F5F8"/>
        <SolidColorBrush x:Key="GridRowBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GridAlternateBrush" Color="#FAFCFE"/>
        <SolidColorBrush x:Key="NeutralBadgeBrush" Color="#EAF0F6"/>
        <SolidColorBrush x:Key="PositiveBadgeBrush" Color="#DDF5E8"/>
        <SolidColorBrush x:Key="PositiveBadgeTextBrush" Color="#187043"/>
        <SolidColorBrush x:Key="WarningBadgeBrush" Color="#FFF0C2"/>
        <SolidColorBrush x:Key="WarningBadgeTextBrush" Color="#A64B00"/>
        <SolidColorBrush x:Key="InfoBadgeBrush" Color="#E1F0FF"/>
        <SolidColorBrush x:Key="InfoBadgeTextBrush" Color="#087BFA"/>
        <SolidColorBrush x:Key="BadgeTextBrush" Color="#344054"/>
        <SolidColorBrush x:Key="SelectedNavBrush" Color="#E1F0FF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#087BFA"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0066D6"/>
        <SolidColorBrush x:Key="DrawerBackgroundBrush" Color="#FFFFFF"/>

        <!-- App Brand Icon -->
        <DrawingImage x:Key="BrandIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F08A24" Geometry="M3,11 L18,3 L33,11 L18,19 Z"/>
                    <GeometryDrawing Brush="#C85D16" Geometry="M3,11 L18,19 L18,37 L3,29 Z"/>
                    <GeometryDrawing Brush="#E77719" Geometry="M18,19 L33,11 L33,29 L18,37 Z"/>
                    <GeometryDrawing Brush="#FFD17A" Geometry="M11,7 L26,15 L22,17 L7,9 Z"/>
                    <GeometryDrawing Brush="#FFE1A3" Geometry="M15,9 L19,11 L19,20 L15,18 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

