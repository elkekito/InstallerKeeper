<Window x:Class="InstallerKeeper.ArchiveCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpieza del archivo de versiones"
        Width="760" Height="580" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="{StaticResource BrandIcon}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Path Data="{StaticResource TrashIconGeometry}" Fill="{DynamicResource PrimaryBrush}"
                  Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Limpieza del archivo de versiones" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Libera espacio en disco eliminando instaladores de versiones antiguas archivadas."
                           Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Metrics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="En el archivo de versiones" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="TotalSummaryText" Text="0 archivos (0 B)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/>
                    <TextBlock x:Name="ArchiveLocationText" Text="Cargando ruta..." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Espacio a liberar" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="PurgeSummaryText" Text="0 archivos a eliminar (0 B)" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,0"/>
                    <TextBlock Text="Se eliminarán de forma permanente" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Retention Policy Options -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Criterio de retención" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                <RadioButton x:Name="Keep1Radio" Content="Conservar la versión archivada más reciente de cada aplicación (eliminar las más antiguas)"
                             IsChecked="True" Checked="PolicyRadio_Changed" Margin="0,2,0,4"/>
                <RadioButton x:Name="Keep2Radio" Content="Conservar las 2 versiones archivadas más recientes"
                             Checked="PolicyRadio_Changed" Margin="0,2,0,4"/>
                <RadioButton x:Name="PurgeAllRadio" Content="Eliminar todos los instaladores archivados (vaciar el archivo por completo)"
                             Checked="PolicyRadio_Changed" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Preview List -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Aplicación" Width="2.2*" SortMemberPath="AppGroup">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AppGroup}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Archivo" Width="2*" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Versión" Width="1*" SortMemberPath="InferredVersion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InferredVersion}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tamaño" Width="1*" SortMemberPath="Item.FileSizeBytes">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Acción" Width="1.2*" SortMemberPath="WillBePurgedText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding WillBePurgedText}"
                                               Foreground="{Binding ActionColorBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="4">
            <Button Content="Actualizar análisis" Style="{StaticResource QuietButton}" Click="Refresh_Click" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar" Style="{StaticResource QuietButton}" Click="Close_Click" Margin="0,0,10,0"/>
                <Button x:Name="PurgeButton" Content="Purgar y liberar espacio" Style="{StaticResource DangerActionButton}" Click="Purge_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
